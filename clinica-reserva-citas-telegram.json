{
  "name": "Clínica - Reserva de Citas via Telegram",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "b1a2c3d4-0001-4000-a000-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [180, 400],
      "webhookId": "clinic-telegram-webhook",
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot - Clínica"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "Eres el asistente virtual de una clínica médica. Tu trabajo es ayudar a los pacientes a reservar citas médicas por Telegram.\n\n## Especialidades disponibles:\n- Medicina General\n- Odontología\n- Pediatría\n- Ginecología\n- Dermatología\n- Oftalmología\n- Cardiología\n- Traumatología\n\n## Horarios:\n- Lunes a Viernes: 8:00 a 18:00\n- Sábados: 8:00 a 13:00\n- Domingos: Cerrado\n\n## Tu comportamiento:\n1. Saluda brevemente y pregunta en qué puedes ayudar.\n2. Cuando el paciente quiera reservar una cita, recopila estos datos uno por uno de forma conversacional:\n   - Nombre completo del paciente\n   - Teléfono de contacto\n   - Especialidad deseada\n   - Fecha preferida (formato YYYY-MM-DD)\n   - Hora preferida (formato HH:MM)\n   - Motivo de la consulta\n\n3. IMPORTANTE: Cuando tengas TODOS los 6 datos completos, DEBES ejecutar las dos herramientas:\n   a) Primero: Llama a 'guardar_cita_google_sheets' con los 6 campos para registrar la cita\n   b) Segundo: Llama a 'crear_evento_google_calendar' para agendar en el calendario\n   c) Después de ejecutar ambas herramientas, confirma al paciente con un resumen\n\n4. NO confirmes la cita sin haber ejecutado las herramientas primero.\n5. Si el paciente pregunta por información de la clínica, dale los horarios y especialidades.\n6. Si quiere cancelar, indícale que se comunique directamente con la clínica.\n7. Sé amable, profesional y conciso.\n8. Responde siempre en español.\n\nFecha de hoy: {{ $now.format('yyyy-MM-dd') }}"
        }
      },
      "id": "b1a2c3d4-0001-4000-a000-000000000002",
      "name": "Agente IA - Clínica",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [480, 400]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.3
        }
      },
      "id": "b1a2c3d4-0001-4000-a000-000000000003",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [300, 620],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "contextWindowLength": 15
      },
      "id": "b1a2c3d4-0001-4000-a000-000000000004",
      "name": "Memoria de Conversación",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [440, 620]
    },
    {
      "parameters": {
        "name": "guardar_cita_google_sheets",
        "description": "Guarda una nueva cita médica en la hoja de Google Sheets. DEBES usar esta herramienta cuando tengas los 6 datos del paciente: nombre, telefono, especialidad, fecha, hora y motivo. Ejecuta esta herramienta ANTES de confirmar la cita al paciente.",
        "source": "define",
        "workflowJson": {
          "nodes": [
            {
              "parameters": {},
              "id": "sw-sheets-trigger",
              "name": "Inicio",
              "type": "n8n-nodes-base.executeWorkflowTrigger",
              "typeVersion": 1.1,
              "position": [200, 300]
            },
            {
              "parameters": {
                "operation": "append",
                "documentId": {
                  "__rl": true,
                  "mode": "url",
                  "value": "TU_URL_DE_GOOGLE_SHEET"
                },
                "sheetName": {
                  "__rl": true,
                  "mode": "list",
                  "value": "Citas"
                },
                "columns": {
                  "mappingMode": "defineBelow",
                  "value": {
                    "Fecha_Registro": "={{ $now.format('yyyy-MM-dd HH:mm:ss') }}",
                    "Nombre": "={{ $json.nombre }}",
                    "Telefono": "={{ $json.telefono }}",
                    "Especialidad": "={{ $json.especialidad }}",
                    "Fecha_Cita": "={{ $json.fecha }}",
                    "Hora_Cita": "={{ $json.hora }}",
                    "Motivo": "={{ $json.motivo }}",
                    "Estado": "Confirmada"
                  },
                  "matchingColumns": [],
                  "schema": [
                    { "id": "Fecha_Registro", "displayName": "Fecha_Registro", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
                    { "id": "Nombre", "displayName": "Nombre", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
                    { "id": "Telefono", "displayName": "Telefono", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
                    { "id": "Especialidad", "displayName": "Especialidad", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
                    { "id": "Fecha_Cita", "displayName": "Fecha_Cita", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
                    { "id": "Hora_Cita", "displayName": "Hora_Cita", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
                    { "id": "Motivo", "displayName": "Motivo", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
                    { "id": "Estado", "displayName": "Estado", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true }
                  ]
                },
                "options": {}
              },
              "id": "sw-sheets-save",
              "name": "Google Sheets - Guardar Cita",
              "type": "n8n-nodes-base.googleSheets",
              "typeVersion": 4.5,
              "position": [420, 300],
              "credentials": {
                "googleSheetsOAuth2Api": {
                  "id": "GOOGLE_SHEETS_CREDENTIAL_ID",
                  "name": "Google Sheets - Clínica"
                }
              }
            }
          ],
          "connections": {
            "Inicio": {
              "main": [
                [
                  { "node": "Google Sheets - Guardar Cita", "type": "main", "index": 0 }
                ]
              ]
            }
          }
        },
        "fields": {
          "values": [
            { "name": "nombre", "description": "Nombre completo del paciente", "type": "string", "required": true },
            { "name": "telefono", "description": "Teléfono de contacto del paciente", "type": "string", "required": true },
            { "name": "especialidad", "description": "Especialidad médica solicitada", "type": "string", "required": true },
            { "name": "fecha", "description": "Fecha de la cita en formato YYYY-MM-DD", "type": "string", "required": true },
            { "name": "hora", "description": "Hora de la cita en formato HH:MM", "type": "string", "required": true },
            { "name": "motivo", "description": "Motivo o razón de la consulta médica", "type": "string", "required": true }
          ]
        }
      },
      "id": "b1a2c3d4-0001-4000-a000-000000000005",
      "name": "Tool - Google Sheets",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2,
      "position": [580, 620]
    },
    {
      "parameters": {
        "name": "crear_evento_google_calendar",
        "description": "Crea un evento en Google Calendar para agendar la cita médica. DEBES usar esta herramienta junto con guardar_cita_google_sheets cuando tengas todos los datos completos del paciente.",
        "source": "define",
        "workflowJson": {
          "nodes": [
            {
              "parameters": {},
              "id": "sw-cal-trigger",
              "name": "Inicio",
              "type": "n8n-nodes-base.executeWorkflowTrigger",
              "typeVersion": 1.1,
              "position": [200, 300]
            },
            {
              "parameters": {
                "calendar": {
                  "__rl": true,
                  "mode": "list",
                  "value": "TU_CALENDAR_ID"
                },
                "title": "={{ $json.titulo }}",
                "start": "={{ $json.fecha }}T{{ $json.hora }}:00",
                "end": "={{ $json.fecha }}T{{ (parseInt($json.hora.split(':')[0]) + 1).toString().padStart(2, '0') }}:{{ $json.hora.split(':')[1] }}:00",
                "additionalFields": {
                  "description": "={{ $json.descripcion }}",
                  "location": "Clínica",
                  "color": "9"
                }
              },
              "id": "sw-cal-create",
              "name": "Google Calendar - Crear Evento",
              "type": "n8n-nodes-base.googleCalendar",
              "typeVersion": 1.3,
              "position": [420, 300],
              "credentials": {
                "googleCalendarOAuth2Api": {
                  "id": "GOOGLE_CALENDAR_CREDENTIAL_ID",
                  "name": "Google Calendar - Clínica"
                }
              }
            }
          ],
          "connections": {
            "Inicio": {
              "main": [
                [
                  { "node": "Google Calendar - Crear Evento", "type": "main", "index": 0 }
                ]
              ]
            }
          }
        },
        "fields": {
          "values": [
            { "name": "titulo", "description": "Título del evento. Formato: Cita: [Nombre] - [Especialidad]", "type": "string", "required": true },
            { "name": "fecha", "description": "Fecha de la cita en formato YYYY-MM-DD", "type": "string", "required": true },
            { "name": "hora", "description": "Hora de inicio de la cita en formato HH:MM", "type": "string", "required": true },
            { "name": "descripcion", "description": "Descripción completa con todos los datos del paciente: nombre, teléfono, especialidad, fecha, hora y motivo", "type": "string", "required": true }
          ]
        }
      },
      "id": "b1a2c3d4-0001-4000-a000-000000000006",
      "name": "Tool - Google Calendar",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2,
      "position": [720, 620]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "b1a2c3d4-0001-4000-a000-000000000007",
      "name": "Responder por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [780, 400],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot - Clínica"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          { "node": "Agente IA - Clínica", "type": "main", "index": 0 }
        ]
      ]
    },
    "Agente IA - Clínica": {
      "main": [
        [
          { "node": "Responder por Telegram", "type": "main", "index": 0 }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          { "node": "Agente IA - Clínica", "type": "ai_languageModel", "index": 0 }
        ]
      ]
    },
    "Memoria de Conversación": {
      "ai_memory": [
        [
          { "node": "Agente IA - Clínica", "type": "ai_memory", "index": 0 }
        ]
      ]
    },
    "Tool - Google Sheets": {
      "ai_tool": [
        [
          { "node": "Agente IA - Clínica", "type": "ai_tool", "index": 0 }
        ]
      ]
    },
    "Tool - Google Calendar": {
      "ai_tool": [
        [
          { "node": "Agente IA - Clínica", "type": "ai_tool", "index": 0 }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
